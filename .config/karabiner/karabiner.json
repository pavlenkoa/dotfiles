                                    }
                                },
                                "to": [{ "key_code": "right_arrow" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Change Command + d/u to PageDown & PageUp",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "i",
                                    "modifiers": {
                                        "mandatory": ["command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "key_code": "page_up" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "g",
                                    "modifiers": {
                                        "mandatory": ["command"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "key_code": "page_down" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Launch Terminal, Safari, Mail",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": {
                                        "mandatory": ["command", "shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "shell_command": "open -aterminal" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "b",
                                    "modifiers": {
                                        "mandatory": ["option", "shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "shell_command": "open -asafari'" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "m",
                                    "modifiers": {
                                        "mandatory": ["option", "shift"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "shell_command": "open -amail'" }],
                                "type": "basic"
                            }
                        ]
                    }
