                "rules": [
                    {
                        "description": "Change Command + h/j/k/l to Arrows",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "h",
                                    "modifiers": {
                                        "mandatory": ["command"],
                                        "optional": ["caps_lock", "shift", "option", "control", "fn"]
