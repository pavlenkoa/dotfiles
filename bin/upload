#!/bin/bash -e

# Usage info
show_help() {
cat << EOF
Usage: ${0##*/} [-hv] [-d DATE] [-j DEST] [-r] [FILE]...
Do stuff with FILE and write the result to standard output. With no FILE
or when FILE is -, read standard input.
    -h          display this help and exit
    -d DATE     date other than today's date
    -j DEST     destination, can be 'personal', 'work', or 'rpi' (default)
    -v          verbose mode. Can be used multiple times for increased
                verbosity.
    -r          append random string to date
EOF
}

# Initialize our own variables:
verbose=0
date=$(date +%Y-%m-%d)
destination="rpi"

OPTIND=1 # Reset is necessary if getopts was used previously in the script.
while getopts "hrvd:j:" opt; do
    case "$opt" in
        h)
            show_help
            exit 0
            ;;
        v)  verbose=$((verbose+1))
            ;;
        d)  date=$(date -d "$OPTARG" +%Y-%m-%d) || { echo "Invalid date: $OPTARG" >&2; exit 1; }
            ;;
        j)  case "$OPTARG" in
                personal|work|rpi) destination=$OPTARG ;;
                *) echo "Invalid destination: $OPTARG. Use 'personal', 'work', or 'rpi'." >&2; exit 1 ;;
            esac
            ;;
        r)  date="${date}-$(head -c 10 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9')"
            ;;
        *)
            show_help >&2
            exit 1
            ;;
    esac
done
shift "$((OPTIND-1))" # Shift off the options and optional --.

# Check for required tools
for cmd in aws rsync file; do
    command -v "$cmd" >/dev/null 2>&1 || { echo >&2 "This script requires $cmd but it's not installed. Aborting."; exit 1; }
done

if [ "$destination" != "rpi" ]; then
    user=$(aws sts get-caller-identity --query "Arn" --output text)
    user=${user#*:user/}
fi

tmp=$(mktemp -d) || { echo "Failed to create temp directory" >&2; exit 1; }
mkdir -p "$tmp/$date"
trap 'rm -rf "$tmp"' EXIT

upload_and_copy() {
    local url="$1"
    if command -v pbcopy >/dev/null 2>&1; then
        echo -n "$url" | pbcopy
    elif command -v xclip >/dev/null 2>&1; then
        echo -n "$url" | xclip -sel clip
    else
        echo "Could not copy to clipboard: neither pbcopy nor xclip is available"
    fi
    logger "$url"
    echo "$url"
}

for src in "$@"; do
    if [ -d "$src" ]; then
        tar="$(basename "$src").tar"
        tar cvf "$tar" "$src" && src="$tar"
    fi
    
    if [ ! -f "$src" ]; then
        echo "Missing filename: $src" >&2
        continue
    fi
    
    chmod +r "$src"
    
    case $(file -b --mime-type "$src") in
        image/jpeg)
            if command -v cwebp >/dev/null 2>&1; then
                webptmp=$(mktemp --suffix=.webp)
                if cwebp "$src" -o "$webptmp"; then
                    echo "Squashing jpeg $(du -h "$src" "$webptmp")"
                    src="${src%.*}.webp"
                    mv "$webptmp" "$src"
                else
                    echo "WebP conversion failed for $src" >&2
                    rm -f "$webptmp"
                fi
            fi
            ;;
        image/png)
            if command -v pngquant >/dev/null 2>&1; then
                pngquant --ext .png -f "$src" || echo "PNG compression failed for $src" >&2
            fi
            ;;
        *)
            echo "Not compressing $src"
            ;;
    esac
    
    dst=$(basename "$src")
    cp -v "$src" "$tmp/$date/$dst"
    
    case "$destination" in
        personal)
            if aws --profile staticbucket s3 cp "$tmp/$date/$dst" "s3://s3.pavlenko.sh/$date/"; then
                upload_and_copy "https://s3.pavlenko.sh/$date/$dst"
            else
                echo "Failed to upload to personal S3 bucket" >&2
            fi
            ;;
        work)
            if aws --profile default s3 cp --acl public-read "$tmp/$date/$dst" "s3://prtn-temp/$user/$date/"; then
                upload_and_copy "https://s3.eu-west-1.amazonaws.com/prtn-temp/$user/$date/$dst"
            else
                echo "Failed to upload to work S3 bucket" >&2
            fi
            ;;
        rpi)
            if rsync -avz "$tmp/$date/$dst" "raspberrypi_ext:~/s.pavlenko.sh/$date/"; then
                upload_and_copy "https://s.pavlenko.sh/$date/$dst"
            else
                echo "Failed to upload to Raspberry Pi" >&2
            fi
            ;;
    esac
done
